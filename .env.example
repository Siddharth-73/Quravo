# ==========================================
# 1. CORE ENVIRONMENT & INFRASTRUCTURE
# ==========================================
NODE_ENV=development
PORT=4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ==========================================
# 2. DATABASE & REDIS QUEUES
# ==========================================
POSTGRES_USER=quravo
POSTGRES_PASSWORD=quravo_secret
POSTGRES_DB=quravo_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://quravo:quravo_secret@localhost:5433/quravo_db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ==========================================
# 3. SECURITY, AUTH & RATE LIMITING
# ==========================================
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=super-secret-refresh-key
COOKIE_SECRET=super-secret-cookie-key

# Upstash Redis Rate Limiting (Optional in local dev)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile CAPTCHA (Optional in local dev)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ==========================================
# 4. THIRD-PARTY SERVICES & INTEGRATIONS
# ==========================================

# AI Gateway (OpenAI or Gemini)
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=AIzaSy...

# Email Service (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM="Quravo Health <notifications@quravo.com>"

# Cloudflare R2 Medical Attachment Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=quravo-medical-files
R2_PUBLIC_URL=https://files.quravo.com

# Monitoring & Error Tracking (Sentry)
SENTRY_DSN=https://...
